# Base URL of the UI, used to build email-verification links.
APP_UI_BASE_URL=http://localhost:4000
# Dev convenience: allow login without email verification.
APP_REQUIRE_EMAIL_VERIFICATION=false

# --- SMTP (email verification) ---
# relay1.dataart.com does not require credentials for now.
# If unreachable, the verification link is also written to the API logs.
SMTP_HOST=relay1.dataart.com
SMTP_PORT=25
SMTP_FROM=no-reply@ticketing.local
SMTP_USER=
SMTP_PASSWORD=

