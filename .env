# DEV-ONLY values, committed for easy testing. Not for production.

# --- Database ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing

# --- API (.NET) ---
# Use Development to enable Swagger/dev behavior; Production otherwise.
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=XLBj8g5AK+eEjFa/LnK5CXPDvgXWv7t/4zg+WY2USB0=
JWT_ISSUER=ticketing-api
JWT_AUDIENCE=ticketing-ui
