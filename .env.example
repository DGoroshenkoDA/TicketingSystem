# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- Database ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=ticketing

# --- API (.NET) ---
# Use Development to enable Swagger/dev behavior; Production otherwise.
ASPNETCORE_ENVIRONMENT=Production
# JWT signing secret (use a long random string).
JWT_SECRET=change_me_a_long_random_jwt_secret_at_least_32_chars
JWT_ISSUER=ticketing-api
JWT_AUDIENCE=ticketing-ui
JWT_EXPIRY_MINUTES=120

# --- UI (Phoenix) ---
# Generate with: mix phx.gen.secret  (64+ bytes)
SECRET_KEY_BASE=change_me_phoenix_secret_key_base_at_least_64_bytes_long_xxxxxxxxxxxx
# Public host the UI is served on (used to build URLs).
PHX_HOST=localhost
