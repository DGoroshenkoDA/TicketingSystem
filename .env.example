# Copy this file to .env and adjust values.
# NOTE: for this project a committed .env with dev-only values is provided too.

# --- Database ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=ticketing

# --- API (.NET) ---
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=change_me_a_long_random_jwt_secret_at_least_32_chars
JWT_ISSUER=ticketing-api
JWT_AUDIENCE=ticketing-ui
JWT_EXPIRY_MINUTES=120

# Base URL of the UI, used to build email-verification links.
APP_UI_BASE_URL=http://localhost:4000
# Set to false to allow login without email verification (dev only).
APP_REQUIRE_EMAIL_VERIFICATION=true

# --- SMTP (email verification) ---
# relay1.dataart.com does not require credentials for now; leave user/password empty.
SMTP_HOST=relay1.dataart.com
SMTP_PORT=25
SMTP_FROM=no-reply@ticketing.local
SMTP_USER=
SMTP_PASSWORD=

# --- UI (Phoenix) ---
SECRET_KEY_BASE=change_me_phoenix_secret_key_base_at_least_64_bytes_long_xxxxxxxxxxxx
PHX_HOST=localhost
