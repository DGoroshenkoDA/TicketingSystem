# Normalize line endings: repo stores LF, checkout uses native by default.
* text=auto

# Force LF for files that must stay LF cross-platform.
*.md        text eol=lf
*.sh        text eol=lf
*.cs        text eol=lf
*.ex        text eol=lf
*.exs       text eol=lf
*.heex      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.gitignore text eol=lf
gradlew     text eol=lf

# Windows scripts stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files: never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.zip       binary
