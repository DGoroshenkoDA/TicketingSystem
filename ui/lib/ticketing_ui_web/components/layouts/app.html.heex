<header class="border-b border-gray-100">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-semibold text-brand">Ticketing System</a>

    <div :if={@current_user} class="flex items-center gap-3 text-sm">
      <span class="text-gray-600">{@current_user.name || @current_user.email}</span>
      <form action="/logout" method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="_method" value="delete" />
        <button type="submit" class="rounded-lg px-3 py-1 text-gray-600 hover:bg-gray-100">
          Log out
        </button>
      </form>
    </div>
  </div>
</header>

<main class="px-4">
  <div class="mx-auto max-w-5xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
