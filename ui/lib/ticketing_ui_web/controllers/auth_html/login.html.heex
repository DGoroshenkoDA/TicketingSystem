<.auth_shell>
  <h1 class="text-2xl font-bold text-brand">Welcome</h1>
  <p class="mt-1.5 text-sm text-slate-500">
    Sign in or create an account to start working with tickets.
  </p>

  <div class="mt-6">
    <.auth_tabs active={:login} />
  </div>

  <p
    :if={@error}
    class="mt-5 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-700"
  >
    {@error}
  </p>

  <form action="/login" method="post" class="mt-6 space-y-4">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

    <.input_field
      label="Email"
      name="email"
      type="email"
      icon="mail"
      value={@email}
      placeholder="you@company.com"
      autocomplete="email"
    />

    <.password_field
      label="Password"
      name="password"
      id="login-password"
      autocomplete="current-password"
    />

    <.submit_button icon="login" label="Sign In" />
  </form>

  <div class="mt-6 border-t border-slate-100 pt-5">
    <p class="text-sm text-slate-500">Haven't verified your email yet?</p>
    <form action="/resend-verification" method="post" class="mt-2 flex gap-2">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="email"
        name="email"
        value={@email}
        placeholder="you@company.com"
        required
        class="block w-full flex-1 rounded-lg border-slate-200 bg-white py-2.5 px-3 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm focus:border-brand focus:ring-1 focus:ring-brand"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50"
      >
        Resend
      </button>
    </form>
  </div>

  <p class="mt-5 text-center text-sm text-slate-500">
    No account?
    <a href="/signup" class="font-medium text-brand hover:underline">Create one</a>
  </p>
</.auth_shell>
