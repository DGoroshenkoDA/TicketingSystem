<.auth_shell>
  <h1 class="text-2xl font-bold text-brand">Welcome</h1>
  <p class="mt-1.5 text-sm text-slate-500">
    Sign in or create an account to start working with tickets.
  </p>

  <div class="mt-6">
    <.auth_tabs active={:signup} />
  </div>

  <p
    :if={@error}
    class="mt-5 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-700"
  >
    {@error}
  </p>

  <form action="/signup" method="post" class="mt-6 space-y-4">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

    <.input_field
      label="Name"
      name="display_name"
      icon="user"
      value={@values["display_name"]}
      placeholder="John Doe"
      autocomplete="name"
    />

    <.input_field
      label="Email"
      name="email"
      type="email"
      icon="mail"
      value={@values["email"]}
      placeholder="you@company.com"
      autocomplete="email"
    />

    <.password_field label="Password" name="password" id="signup-password" minlength="8" />

    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3.5">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        Password criteria
      </p>
      <ul class="mt-2.5 space-y-1.5 text-sm text-slate-500" data-pw-criteria>
        <li class="crit flex items-center gap-2.5" data-criterion="len">
          <span class="crit-ind"><.icon name="check" class="h-3 w-3" /></span>
          <span>Minimum 8 characters</span>
        </li>
        <li class="crit flex items-center gap-2.5" data-criterion="upper">
          <span class="crit-ind"><.icon name="check" class="h-3 w-3" /></span>
          <span>At least one uppercase (capital) letter</span>
        </li>
        <li class="crit flex items-center gap-2.5" data-criterion="special">
          <span class="crit-ind"><.icon name="check" class="h-3 w-3" /></span>
          <span>At least one special character</span>
        </li>
        <li class="crit flex items-center gap-2.5 border-t border-slate-200 pt-1.5" data-criterion="all">
          <span class="crit-ind"><.icon name="check" class="h-3 w-3" /></span>
          <span>All criteria met</span>
        </li>
      </ul>
    </div>

    <.password_field label="Confirm Password" name="password_confirm" id="signup-password-confirm" />

    <.submit_button icon="user-plus" label="Create Account" data-signup-submit="true" />
  </form>

  <p class="mt-5 text-center text-sm text-slate-500">
    Already have an account?
    <a href="/login" class="font-medium text-brand hover:underline">Sign in</a>
  </p>
</.auth_shell>
