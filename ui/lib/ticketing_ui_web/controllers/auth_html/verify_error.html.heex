<.auth_shell>
  <div class="text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 text-amber-600">
      <.icon name="alert" class="h-7 w-7" />
    </div>
    <h1 class="mt-5 text-2xl font-bold text-slate-900">Expired or invalid link</h1>
    <p class="mt-2 text-sm text-slate-500">
      This verification link is invalid or has expired. Request a new one below.
    </p>
  </div>

  <form action="/resend-verification" method="post" class="mt-6 flex gap-2">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input
      type="email"
      name="email"
      placeholder="you@company.com"
      required
      class="block w-full flex-1 rounded-lg border-slate-200 bg-white py-2.5 px-3 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm focus:border-brand focus:ring-1 focus:ring-brand"
    />
    <button
      type="submit"
      class="shrink-0 rounded-lg bg-brand px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-hover"
    >
      Resend
    </button>
  </form>

  <p class="mt-5 text-center text-sm text-slate-500">
    <a href="/login" class="font-medium text-brand hover:underline">Back to login</a>
  </p>
</.auth_shell>
