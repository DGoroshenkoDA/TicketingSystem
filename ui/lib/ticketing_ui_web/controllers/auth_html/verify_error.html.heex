<div class="mx-auto max-w-sm py-16 text-center">
  <h1 class="text-2xl font-bold text-gray-900">Expired or invalid link</h1>
  <p class="mt-2 text-gray-600">
    This verification link is invalid or has expired. Request a new one below.
  </p>

  <form action="/resend-verification" method="post" class="mt-6 flex gap-2">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input
      type="email"
      name="email"
      placeholder="name@example.com"
      required
      class="flex-1 rounded-lg border-gray-300 focus:border-brand focus:ring-brand"
    />
    <button type="submit" class="rounded-lg bg-brand px-4 py-2 font-medium text-white hover:bg-brand-hover">
      Resend email
    </button>
  </form>

  <p class="mt-4 text-sm text-gray-500">
    <a href="/login" class="font-medium text-brand hover:underline">Back to login</a>
  </p>
</div>
