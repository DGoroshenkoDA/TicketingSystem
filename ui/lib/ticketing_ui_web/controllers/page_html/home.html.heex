<div class="py-16">
  <h1 class="text-2xl font-bold text-gray-900">
    Welcome, {@current_user.name || @current_user.email}
  </h1>
  <p class="mt-3 text-gray-600">
    You are signed in. Open the Kanban board to manage tickets, or jump to your teams and epics.
  </p>

  <div class="mt-6 flex gap-3">
    <a href="/board" class="rounded-lg bg-brand px-4 py-2 font-medium text-white hover:bg-brand-hover">
      Open board
    </a>
    <a href="/teams" class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50">
      Teams
    </a>
    <a href="/epics" class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50">
      Epics
    </a>
  </div>
</div>
